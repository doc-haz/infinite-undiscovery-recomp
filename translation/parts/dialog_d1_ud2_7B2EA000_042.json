  {
   "stem": "d1_ud2_7B2EA000_042",
   "id": "2",
   "en": "Whoa! That was close!",
   "es": "¡Vaya! ¡Eso ha estado cerca!",
   "ctx": "dialogo"
  },
  {
   "stem": "d1_ud2_7B2EA000_042",
   "id": "4",
   "en": "All of this for her silly obsession.",
